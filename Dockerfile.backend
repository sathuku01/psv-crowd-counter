FROM golang:1.24-alpine AS builder

# Install OpenCV and dependencies including build tools
RUN apk add --no-cache \
    gcc \
    musl-dev \
    opencv-dev \
    pkgconfig \
    git \
    g++

WORKDIR /app

# Copy go mod and sum files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the backend API
RUN go build -o backend-api ./cmd/backend-api

# Final stage
FROM alpine:latest

# Install CA certificates and OpenCV runtime
RUN apk --no-cache add ca-certificates libstdc++

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/backend-api .

# Create data directory
RUN mkdir -p data

# Expose port
EXPOSE 8080

# Command to run
CMD ["./backend-api"]